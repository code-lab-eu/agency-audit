[Unit]
Description=Daily run of Agency Audit
Requires=agency-audit-db.container
# The dashboard applies the database migrations when it starts. When both units
# start together, such as at boot after a missed run, the tick waits for them.
After=agency-audit-db.container agency-audit.container

[Container]
ContainerName=agency-audit-tick
Image=agency-audit.build
Exec=agency-audit tick
# A oneshot container runs attached: the output of the container reaches the
# journal through the stdout of podman. Passthrough writes each line once; the
# default journald driver of conmon would write it a second time.
LogDriver=passthrough
Environment=AGENCY_AUDIT_PG_HOST=db
Network=agency-audit.network
Secret=agency-audit-db-password,type=env,target=AGENCY_AUDIT_PG_PASSWORD
Secret=agency-audit-google-maps-api-key,type=env,target=AGENCY_AUDIT_GOOGLE_MAPS_API_KEY
Secret=agency-audit-phorge-api-token,type=env,target=AGENCY_AUDIT_PHORGE_API_TOKEN

[Service]
# Started by systemd/agency-audit-tick.timer. Without RemainAfterExit=yes, so
# that the unit becomes inactive when the run ends and the timer can start it
# again (podman-systemd.unit(5)).
Type=oneshot
