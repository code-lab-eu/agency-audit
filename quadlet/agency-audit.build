[Unit]
Description=Image of Agency Audit

[Build]
ImageTag=localhost/agency-audit:latest
# Fetch a base image again when its digest changed, so that each build gets
# its security fixes. Without network access the local image is used.
Pull=newer
# The build context is the root of the repository, with the Dockerfile. Quadlet
# resolves a relative path against the directory of this file, also when it is
# reached through a symbolic link.
SetWorkingDirectory=..
